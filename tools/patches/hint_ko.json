{
 "omokage/hint/index.html": {
  "0": "\r\n    극단 오모카게｜힌트 페이지\r\n  ",
  "1": "\r\n        극단 오모카게\r\n      ",
  "2": "\r\n\r\n        ※스포일러가 포함되어 있습니다",
  "3": "\r\n        열람은 본인 책임으로 부탁드립니다\r\n\r\n      ",
  "4": "\r\n          검색창을 찾을 수 없어요\r\n        ",
  "5": "\r\n            힌트 ①\r\n          ",
  "6": "\r\n              클릭할 수 있는 곳은\r\n              모두 클릭해 봅시다\r\n            ",
  "7": "\r\n            힌트 ②\r\n          ",
  "8": "\r\n              링크가 끊긴 걸까요?\r\n              화면이 안 나온다면\r\n              홈으로 돌아가 보는 것도 방법입니다.\r\n            ",
  "9": "\r\n            정답\r\n          ",
  "10": "\r\n              5페이지의 제10회 공연\r\n              전단 이미지를 클릭하면\r\n              404 화면으로 넘어갑니다.\r\n              거기서 「홈으로 돌아가기」를 클릭하세요.\r\n            ",
  "11": "\r\n            힌트 ①\r\n          ",
  "12": "\r\n              어딘가에 비밀번호가 걸려서\r\n              볼 수 없는 곳이 있었죠\r\n            ",
  "13": "\r\n            힌트 ②\r\n          ",
  "14": "\r\n              비밀번호가 최근에 바뀌어서\r\n              어느 서류에\r\n              메모해 둔 것 같습니다\r\n            ",
  "15": "\r\n            정답\r\n          ",
  "16": "\r\n              11페이지의\r\n              「봄을 기다리며」 발주서 5장째에\r\n              비밀번호가 적혀 있습니다.\r\n\r\n              그 비밀번호로\r\n              연습 기록을 열람할 수 있습니다.\r\n            ",
  "17": "\r\n            힌트\r\n          ",
  "18": "\r\n              16페이지 안에도\r\n              이미지 안에도\r\n              나오는 말이 있지 않나요?\r\n            ",
  "19": "\r\n            정답\r\n          ",
  "20": "\r\n              「동의서」로 검색\r\n            ",
  "21": "\r\n            힌트\r\n          ",
  "22": "\r\n              17페이지에\r\n              배역 준비에는 필요 없어 보이는 공정이\r\n              있지 않았나요?\r\n            ",
  "23": "\r\n            정답\r\n          ",
  "24": "\r\n              「라이프스타일」로 검색\r\n            ",
  "25": "\r\n            힌트\r\n          ",
  "26": "\r\n              18페이지에\r\n              누가 봐도 불길한 말이\r\n              있지 않았나요?\r\n            ",
  "27": "\r\n            정답\r\n          ",
  "28": "\r\n              「출하」로 검색\r\n            ",
  "29": "\r\n            힌트\r\n          ",
  "30": "\r\n              19페이지에\r\n              처음 보는 서류 이름이 있네요\r\n            ",
  "31": "\r\n            정답\r\n          ",
  "32": "\r\n              「극단원 안내서」로 검색\r\n            ",
  "33": "\r\n            힌트\r\n          ",
  "34": "\r\n              23페이지 내용은\r\n              전부 수상하지만,\r\n              하나만 강조되어 있네요\r\n            ",
  "35": "\r\n            정답\r\n          ",
  "36": "\r\n              「SNS 계정」으로 검색\r\n            ",
  "37": "\r\n            힌트 ①\r\n          ",
  "38": "\r\n              먼저 37페이지를 여세요\r\n            ",
  "39": "\r\n            힌트 ②\r\n          ",
  "40": "\r\n              처음 나온 이름이 있네요\r\n            ",
  "41": "\r\n            정답\r\n          ",
  "42": "\r\n              「미나」로 검색\r\n            ",
  "43": "\r\n            힌트 ①\r\n          ",
  "44": "\r\n              먼저 35페이지를 여세요\r\n            ",
  "45": "\r\n            힌트 ②\r\n          ",
  "46": "\r\n              히라노는 뭐라고 불렸나요?\r\n            ",
  "47": "\r\n            정답\r\n          ",
  "48": "\r\n              「신봉자」로 검색\r\n            ",
  "49": "\r\n            힌트 ①\r\n          ",
  "50": "\r\n              먼저 36페이지를 여세요\r\n            ",
  "51": "\r\n            힌트 ②\r\n          ",
  "52": "\r\n              미야자키는 동생의 무엇이었나요?\r\n            ",
  "53": "\r\n            정답\r\n          ",
  "54": "\r\n              「절친」으로 검색\r\n            ",
  "55": "\r\n            힌트\r\n          ",
  "56": "\r\n              24페이지에\r\n              정보가 잔뜩 들어 있을 것 같은\r\n              데이터 이름이 실려 있네요\r\n            ",
  "57": "\r\n            정답\r\n          ",
  "58": "\r\n              「극단원 페이지」로 검색\r\n            ",
  "59": "\r\n            힌트 ①\r\n          ",
  "60": "\r\n              먼저 34페이지를 여세요\r\n            ",
  "61": "\r\n            힌트 ②\r\n          ",
  "62": "\r\n              그 여성은 취미까지\r\n              바뀌어 버린 것 같습니다\r\n            ",
  "63": "\r\n            정답\r\n          ",
  "64": "\r\n              「아웃도어」로 검색\r\n            ",
  "65": "\r\n            힌트\r\n          ",
  "66": "\r\n              28~32페이지에\r\n              공통으로 나온\r\n              수상한 서비스가 있죠\r\n            ",
  "67": "\r\n            정답\r\n          ",
  "68": "\r\n              「재연 서비스」로 검색\r\n            ",
  "69": "\r\n            힌트\r\n          ",
  "70": "\r\n              34페이지에\r\n              어색한 빨간 밑줄이 있지 않나요?\r\n            ",
  "71": "\r\n            정답\r\n          ",
  "72": "\r\n              「가족」으로 검색\r\n            ",
  "73": "\r\n            힌트\r\n          ",
  "74": "\r\n              26페이지에서\r\n              히라노가 끝까지 읽지 못한 건\r\n              동생의 어떤 각본이었나요?\r\n            ",
  "75": "\r\n            정답\r\n          ",
  "76": "\r\n              「반평생」으로 검색\r\n            ",
  "77": "\r\n            힌트\r\n          ",
  "78": "\r\n              27페이지에\r\n              어색한 빨간 밑줄이 있지 않나요?\r\n            ",
  "79": "\r\n            정답\r\n          ",
  "80": "\r\n              「되살아났다」로 검색\r\n            ",
  "81": "\r\n            힌트\r\n          ",
  "82": "\r\n              25페이지에\r\n              뭔가 메모가 적혀 있네요\r\n            ",
  "83": "\r\n            정답\r\n          ",
  "84": "\r\n              「차기작」으로 검색\r\n            "
 }
}